server {
    listen 80;
    server_name <YOUR_DOMAIN>;
    client_max_body_size 20m;
    access_log /var/log/nginx/access_gzly.log gzly_main;

    location /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
    }

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Mobile fallback: some embedded browsers do not complete the HTTP -> HTTPS redirect.
    # Serve the same SPA over HTTP so bare-domain visits do not become a blank page.
    location / {
        root /opt/gzly/frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires 0;
    }

    location ~* ^/assets/.*\.js$ {
        root /opt/gzly/frontend/dist;
        try_files $uri @gzly_http_stale_js;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* ^/assets/.*\.css$ {
        root /opt/gzly/frontend/dist;
        try_files $uri @gzly_http_empty_css;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        root /opt/gzly/frontend/dist;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location @gzly_http_stale_js {
        default_type application/javascript;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        return 200 "window.location.replace('/?cache_bust=' + Date.now());";
    }

    location @gzly_http_empty_css {
        default_type text/css;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        return 200 "";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    location ^~ /uploads/ {
        alias /opt/gzly/backend/uploads/;
        expires 1y;
        add_header Cache-Control public;
    }
}

server {
    listen 443 ssl http2;
    server_name <YOUR_DOMAIN>;
    client_max_body_size 20m;
    access_log /var/log/nginx/access_gzly.log gzly_main;

    ssl_certificate /etc/nginx/ssl/<DOMAIN>.rsa.pem;
    ssl_certificate_key /etc/nginx/ssl/<DOMAIN>.rsa.key;
    ssl_certificate /etc/nginx/ssl/<DOMAIN>.pem;
    ssl_certificate_key /etc/nginx/ssl/<DOMAIN>.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ecdh_curve X25519:prime256v1:secp384r1;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # HTML: 禁止缓存，确保每次拿到最新版本
    location / {
        root /opt/gzly/frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires 0;
    }

    # 带hash的静态资源: 长期缓存；旧 HTML 引用已删除 chunk 时触发软刷新，修复移动浏览器缓存白屏。
    location ~* ^/assets/.*\.js$ {
        root /opt/gzly/frontend/dist;
        try_files $uri @gzly_stale_js;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* ^/assets/.*\.css$ {
        root /opt/gzly/frontend/dist;
        try_files $uri @gzly_empty_css;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        root /opt/gzly/frontend/dist;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location @gzly_stale_js {
        default_type application/javascript;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        return 200 "window.location.replace('/?cache_bust=' + Date.now());";
    }

    location @gzly_empty_css {
        default_type text/css;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        return 200 "";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    location ^~ /uploads/ {
        alias /opt/gzly/backend/uploads/;
        expires 1y;
        add_header Cache-Control public;
    }
}
