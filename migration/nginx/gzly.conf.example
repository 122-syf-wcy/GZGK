# =========================================================================
# 反爬 / 反扫描公共配置（map + limit_zone）。
# 这些指令必须出现在 http {} 上下文；放在 conf.d/gzly.conf 顶部由 nginx 自动
# include 进 http。如果生产 nginx 已在 nginx.conf 中定义了同名 zone，请删除
# 这里的对应行避免重复定义。
# =========================================================================

# 1. 恶意 UA 黑名单：直接 444 关闭连接，不返回任何响应（不消耗带宽，不暴露版本）。
#    保留 Baiduspider / Googlebot / Bingbot / 360Spider / Sogou 等正规搜索引擎 UA。
map $http_user_agent $gzly_bad_ua {
    default                                  0;
    ""                                       1;
    "~*curl/"                                1;
    "~*python-requests"                      1;
    "~*python-urllib"                        1;
    "~*\bwget\b"                             1;
    "~*\bscrapy\b"                           1;
    "~*\bnikto\b"                            1;
    "~*\bsqlmap\b"                           1;
    "~*\bnessus\b"                           1;
    "~*\bnmap\b"                             1;
    "~*\bmasscan\b"                          1;
    "~*\bzgrab\b"                            1;
    "~*\bzmap\b"                             1;
    "~*acunetix"                             1;
    "~*Apache-HttpClient"                    1;
    "~*Java/"                                1;
    "~*Go-http-client"                       1;
    "~*okhttp"                               1;
    "~*node-fetch"                           1;
    "~*HeadlessChrome"                       1;
    "~*PhantomJS"                            1;
    "~*MJ12bot"                              1;
    "~*AhrefsBot"                            1;
    "~*SemrushBot"                           1;
    "~*DotBot"                               1;
    "~*PetalBot"                             1;
    "~*Bytespider"                           1;
    "~*ZoominfoBot"                          1;
}

# 2. API 速率限制：每个 IP 平均 2 req/s，桶 30；超过即 503，1 秒内连续超过即降级。
#    志愿生成 / AI 解读已经有应用层限流，这里只兜底打扫描器和爬虫。
limit_req_zone $binary_remote_addr zone=gzly_api:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=gzly_conn:10m;

server {
    listen 80;
    server_name <YOUR_DOMAIN>;
    client_max_body_size 20m;
    access_log /var/log/nginx/access_gzly.log gzly_main;

    # 反爬：黑名单 UA 直接 444
    if ($gzly_bad_ua) { return 444; }

    # 反爬：拒绝常见扫描器路径（爬虫 / 漏扫永远先访问这些）
    location ~* (\.env$|\.git/|\.svn/|\.hg/|/wp-admin|/wp-login|/wp-content|/wp-includes|/xmlrpc\.php|/phpmyadmin|/pma/|/adminer|/druid/|/actuator/|/console/|/\.aws/|/\.ssh/|/server-status|/_ignition/|/install\.php|/eval-stdin\.php) {
        access_log off;
        return 444;
    }

    location /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
    }

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Mobile fallback: some embedded browsers do not complete the HTTP -> HTTPS redirect.
    # Serve the same SPA over HTTP so bare-domain visits do not become a blank page.
    location / {
        root /opt/gzly/frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires 0;
    }

    location ~* ^/assets/.*\.js$ {
        root /opt/gzly/frontend/dist;
        try_files $uri @gzly_http_stale_js;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* ^/assets/.*\.css$ {
        root /opt/gzly/frontend/dist;
        try_files $uri @gzly_http_empty_css;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        root /opt/gzly/frontend/dist;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location @gzly_http_stale_js {
        default_type application/javascript;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        return 200 "window.location.replace('/?cache_bust=' + Date.now());";
    }

    location @gzly_http_empty_css {
        default_type text/css;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        return 200 "";
    }

    location /api/ {
        # 反爬：速率限制 + 单 IP 并发上限。SSE 长连接特例放后面单独 location。
        limit_req zone=gzly_api burst=30 nodelay;
        limit_conn gzly_conn 20;
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    location ^~ /uploads/ {
        alias /opt/gzly/backend/uploads/;
        expires 1y;
        add_header Cache-Control public;
    }
}

server {
    listen 443 ssl http2;
    server_name <YOUR_DOMAIN>;
    client_max_body_size 20m;
    access_log /var/log/nginx/access_gzly.log gzly_main;

    # 反爬：黑名单 UA 直接 444（HTTPS 入口同样要拦）
    if ($gzly_bad_ua) { return 444; }

    # 反爬：拒绝常见扫描器路径
    location ~* (\.env$|\.git/|\.svn/|\.hg/|/wp-admin|/wp-login|/wp-content|/wp-includes|/xmlrpc\.php|/phpmyadmin|/pma/|/adminer|/druid/|/actuator/|/console/|/\.aws/|/\.ssh/|/server-status|/_ignition/|/install\.php|/eval-stdin\.php) {
        access_log off;
        return 444;
    }

    ssl_certificate /etc/nginx/ssl/<DOMAIN>.rsa.pem;
    ssl_certificate_key /etc/nginx/ssl/<DOMAIN>.rsa.key;
    ssl_certificate /etc/nginx/ssl/<DOMAIN>.pem;
    ssl_certificate_key /etc/nginx/ssl/<DOMAIN>.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ecdh_curve X25519:prime256v1:secp384r1;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # HTML: 禁止缓存，确保每次拿到最新版本
    location / {
        root /opt/gzly/frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires 0;
    }

    # 带hash的静态资源: 长期缓存；旧 HTML 引用已删除 chunk 时触发软刷新，修复移动浏览器缓存白屏。
    location ~* ^/assets/.*\.js$ {
        root /opt/gzly/frontend/dist;
        try_files $uri @gzly_stale_js;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* ^/assets/.*\.css$ {
        root /opt/gzly/frontend/dist;
        try_files $uri @gzly_empty_css;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        root /opt/gzly/frontend/dist;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location @gzly_stale_js {
        default_type application/javascript;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        return 200 "window.location.replace('/?cache_bust=' + Date.now());";
    }

    location @gzly_empty_css {
        default_type text/css;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        return 200 "";
    }

    # SSE 长连接（AI 解读 / Skills 对话）单独 location：不走 limit_req 否则会把流式响应打断。
    location ~ ^/api/volunteer/(ai-analysis|zhangxuefeng-skills-chat) {
        limit_conn gzly_conn 4;
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        chunked_transfer_encoding on;
    }

    location /api/ {
        # 反爬：速率限制 + 单 IP 并发上限
        limit_req zone=gzly_api burst=30 nodelay;
        limit_conn gzly_conn 20;
        proxy_pass http://127.0.0.1:8090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    location ^~ /uploads/ {
        alias /opt/gzly/backend/uploads/;
        expires 1y;
        add_header Cache-Control public;
    }
}
