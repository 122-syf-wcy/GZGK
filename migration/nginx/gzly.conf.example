# =========================================================================
# 反爬 / 反扫描的 limit_req_zone / limit_conn_zone / map 公共定义已抽到
# migration/nginx/gzly-shared.conf.example，本文件只引用：
#   $gzly_bad_ua / $gzly_bad_path / gzly_api / gzly_generate / gzly_ai /
#   gzly_admin_login / gzly_stats / gzly_conn
# 部署时必须同时把 gzly-shared.conf.example 复制为
# /etc/nginx/conf.d/00-zzz-gzly-shared.conf 才能让本文件正常 reload。
# =========================================================================

server {
    listen 80;
    server_name <YOUR_DOMAIN>;
    client_max_body_size 20m;
    access_log /var/log/nginx/access_gzly.log gzly_main;

    # 反爬：黑名单 UA / 扫描器路径直接 444 关闭连接（不消耗后端，也不暴露版本）
    if ($gzly_bad_ua)   { return 444; }
    if ($gzly_bad_path) { return 444; }
    limit_conn gzly_conn 30;

    location /.well-known/acme-challenge/ {
        root /usr/share/nginx/html;
    }

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # Mobile fallback: some embedded browsers do not complete the HTTP -> HTTPS redirect.
    # Serve the same SPA over HTTP so bare-domain visits do not become a blank page.
    location / {
        root /opt/gzly/frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires 0;
    }

    location ~* ^/assets/.*\.js$ {
        root /opt/gzly/frontend/dist;
        try_files $uri @gzly_http_stale_js;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* ^/assets/.*\.css$ {
        root /opt/gzly/frontend/dist;
        try_files $uri @gzly_http_empty_css;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        root /opt/gzly/frontend/dist;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location @gzly_http_stale_js {
        default_type application/javascript;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        return 200 "window.location.replace('/?cache_bust=' + Date.now());";
    }

    location @gzly_http_empty_css {
        default_type text/css;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        return 200 "";
    }

    location /api/ {
        # 反爬：兜底速率（gzly_api 30r/s 来自 gzly-shared.conf）
        limit_req zone=gzly_api burst=60 nodelay;
        limit_conn gzly_conn 20;
        proxy_pass http://gzly_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    location ^~ /uploads/ {
        alias /opt/gzly/backend/uploads/;
        expires 1y;
        add_header Cache-Control public;
    }
}

server {
    listen 443 ssl http2;
    server_name <YOUR_DOMAIN>;
    client_max_body_size 20m;
    access_log /var/log/nginx/access_gzly.log gzly_main;

    # 反爬：HTTPS 入口同样套用 shared 模板的 UA / path 黑名单
    if ($gzly_bad_ua)   { return 444; }
    if ($gzly_bad_path) { return 444; }
    limit_conn gzly_conn 30;

    ssl_certificate /etc/nginx/ssl/<DOMAIN>.rsa.pem;
    ssl_certificate_key /etc/nginx/ssl/<DOMAIN>.rsa.key;
    ssl_certificate /etc/nginx/ssl/<DOMAIN>.pem;
    ssl_certificate_key /etc/nginx/ssl/<DOMAIN>.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ecdh_curve X25519:prime256v1:secp384r1;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;

    # HTML: 禁止缓存，确保每次拿到最新版本
    location / {
        root /opt/gzly/frontend/dist;
        index index.html;
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires 0;
    }

    # 带hash的静态资源: 长期缓存；旧 HTML 引用已删除 chunk 时触发软刷新，修复移动浏览器缓存白屏。
    location ~* ^/assets/.*\.js$ {
        root /opt/gzly/frontend/dist;
        try_files $uri @gzly_stale_js;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* ^/assets/.*\.css$ {
        root /opt/gzly/frontend/dist;
        try_files $uri @gzly_empty_css;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location ~* \.(png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        root /opt/gzly/frontend/dist;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location @gzly_stale_js {
        default_type application/javascript;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        return 200 "window.location.replace('/?cache_bust=' + Date.now());";
    }

    location @gzly_empty_css {
        default_type text/css;
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        return 200 "";
    }

    # SSE 长连接（AI 解读 / Skills 对话）单独 location：不走主 limit_req 否则会被打断流式响应。
    # 走 gzly_ai 桶（6 r/min，来自 gzly-shared.conf）做应用层兜底节流，与后端 AI 限流叠加。
    location ~ ^/api/volunteer/(ai-analysis|zhangxuefeng-skills-chat) {
        limit_req zone=gzly_ai burst=3 nodelay;
        limit_conn gzly_conn 4;
        proxy_pass http://gzly_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        chunked_transfer_encoding on;
    }

    # 志愿生成单独走 gzly_generate（20 r/min）；剩余 /api/ 走通用 gzly_api（30 r/s）
    location = /api/volunteer/generate {
        limit_req zone=gzly_generate burst=10 nodelay;
        limit_conn gzly_conn 10;
        proxy_pass http://gzly_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    location /api/ {
        # 反爬：通用 API 速率限制 + 单 IP 并发上限
        limit_req zone=gzly_api burst=60 nodelay;
        limit_conn gzly_conn 20;
        proxy_pass http://gzly_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 10s;
    }

    location ^~ /uploads/ {
        alias /opt/gzly/backend/uploads/;
        expires 1y;
        add_header Cache-Control public;
    }
}
