# GZLY shared rate limit + WAF maps + default-deny servers.
# Loaded last in /etc/nginx/conf.d (filename starts with 00-zzz to sort last
# among the 00- prefixed configs but maps work regardless of include order).
# Only impacts servers that explicitly reference these zones / variables.
#
# 新服务器部署：
#   cp migration/nginx/gzly-shared.conf.example /etc/nginx/conf.d/00-zzz-gzly-shared.conf
#   nginx -t && systemctl reload nginx
# 同时必须部署 gzly.conf.example 作为主 vhost；主 vhost 会引用本文件定义的
# $gzly_bad_ua / $gzly_bad_path / gzly_api / gzly_generate / gzly_ai /
# gzly_admin_login / gzly_stats / gzly_conn。

# ---------- rate limit zones (10m = ~160k unique client IPs each) ----------
limit_req_zone $binary_remote_addr zone=gzly_api:10m         rate=30r/s;
limit_req_zone $binary_remote_addr zone=gzly_generate:10m    rate=20r/m;   # ~1/3s
limit_req_zone $binary_remote_addr zone=gzly_ai:10m          rate=6r/m;    # ~1/10s
limit_req_zone $binary_remote_addr zone=gzly_admin_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=gzly_stats:10m       rate=120r/m;

# Concurrent connections per IP cap (defense against SSE / slow loris).
limit_conn_zone $binary_remote_addr zone=gzly_conn:10m;

# ---------- Upstream with keepalive (added v7.39 2026-05-17 高并发优化) ----------
# 主 vhost 必须用 proxy_pass http://gzly_backend; + proxy_http_version 1.1;
# + proxy_set_header Connection ""; 才能复用长连接，否则每请求新建 TCP，
# 在 4 vCPU 实例上会被 TIME_WAIT 堆积拖死。
upstream gzly_backend {
    server 127.0.0.1:8090 max_fails=3 fail_timeout=10s;
    keepalive 64;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

# ---------- WAF maps ----------
# Empty UA / known scanner UA -> $gzly_bad_ua=1
map $http_user_agent $gzly_bad_ua {
    default                                 0;
    ""                                      1;
    "-"                                     1;
    "~*zgrab"                               1;
    "~*nmap"                                1;
    "~*sqlmap"                              1;
    "~*masscan"                             1;
    "~*nikto"                               1;
    "~*nessus"                              1;
    "~*wfuzz"                               1;
    "~*acunetix"                            1;
    "~*burp"                                1;
    "~*ahrefsbot"                           1;
    "~*semrushbot"                          1;
    "~*mj12bot"                             1;
    "~*petalbot"                            1;
    "~*python-requests/2\\."                1;
    "~*go-http-client"                      1;
    "~*libwww-perl"                         1;
    "~*curl/7\\.[0-5]"                      1;
}

# Common scanner probe paths -> $gzly_bad_path=1
map $request_uri $gzly_bad_path {
    default                                 0;
    "~*/\\.env"                             1;
    "~*/\\.git(/|$)"                        1;
    "~*/\\.svn(/|$)"                        1;
    "~*/\\.hg(/|$)"                         1;
    "~*/phpunit"                            1;
    "~*/eval-stdin"                         1;
    "~*\\.php(\\?|$)"                       1;
    "~*\\.aspx?(\\?|$)"                     1;
    "~*\\.jsp(\\?|$)"                       1;
    "~*\\.cgi(\\?|$)"                       1;
    "~*/wp-(admin|login|content|includes)"  1;
    "~*/xmlrpc"                             1;
    "~*/vendor/.*\\.php"                    1;
    "~*/owa/"                               1;
    "~*/\\.well-known/security\\.txt"       1;
    "~*/manager/(html|status|text)"         1;
    "~*/console/"                           1;
    "~*/druid/"                             1;
    "~*/actuator/(env|heapdump|jolokia)"    1;
    "~*\\.sql(\\?|$)"                       1;
    "~*\\.bak(\\?|$)"                       1;
    "~*\\.tar(\\?|\\.gz|$)"                 1;
    "~*\\.zip(\\?|$)"                       1;
}

# ---------- catch-all default servers (no Host / bad Host -> close conn) ----------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name gzly-default-deny.invalid;
    access_log off;
    return 444;
}

server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name gzly-default-deny.invalid;
    ssl_reject_handshake on;
    access_log off;
    return 444;
}
