<?xml version="1.0" encoding="UTF-8"?>
<!--
  GZLY 后端日志配置。
  生产 stdout 经 systemd 重定向后会无限增长，本配置接管日志输出：
  - 全量日志按天 + 100MB 切割，保留 14 天，总容量上限 5GB
  - ERROR 单独输出到 error.log，方便 grep 与告警，保留 30 天
  - 控制台保留 INFO 给开发与 systemd journal
  - 关闭过于 noisy 的第三方 logger（Hibernate/Tomcat startup）
  日志根路径优先取环境变量 GZLY_LOG_DIR；生产 systemd 已设为 /opt/gzly/logs。
-->
<configuration scan="true" scanPeriod="60 seconds">
    <springProperty name="LOG_DIR" source="gzly.log.dir" defaultValue="${GZLY_LOG_DIR:-./logs}"/>
    <springProperty name="LOG_LEVEL" source="gzly.log.level" defaultValue="INFO"/>
    <springProperty name="LOG_LEVEL_ROOT" source="gzly.log.level-root" defaultValue="INFO"/>

    <property name="PATTERN_PLAIN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>
    <property name="PATTERN_COLOR" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) %cyan([%thread]) %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN_COLOR}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/gzly.log</file>
        <encoder>
            <pattern>${PATTERN_PLAIN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/gzly.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/gzly-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>${PATTERN_PLAIN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/gzly-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
    </appender>

    <appender name="APP_FILE_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="APP_FILE"/>
    </appender>

    <appender name="ERROR_FILE_ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="ERROR_FILE"/>
    </appender>

    <logger name="com.gzly" level="${LOG_LEVEL}"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.apache.catalina.startup" level="WARN"/>
    <logger name="org.springframework.web.servlet.PageNotFound" level="WARN"/>
    <logger name="org.springframework.boot.autoconfigure" level="WARN"/>

    <root level="${LOG_LEVEL_ROOT}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE_ASYNC"/>
        <appender-ref ref="ERROR_FILE_ASYNC"/>
    </root>
</configuration>
