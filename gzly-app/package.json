{
  "name": "gzly-app",
  "version": "0.1.0",
  "description": "GZLY 高考志愿公益辅助系统移动端",
  "private": true,
  "scripts": {
    "dev:app": "uni -p app",
    "build:app": "npm run check:compliance && uni build -p app",
    "check:compliance": "node scripts/check-compliance.mjs",
    "dev:h5": "uni",
    "build:h5": "uni build",
    "type-check": "vue-tsc --noEmit",
    "assets:generate": "node scripts/generate-assets.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020320260806002",
    "@dcloudio/uni-app-plus": "3.0.0-5020320260806002",
    "@dcloudio/uni-components": "3.0.0-5020320260806002",
    "@dcloudio/uni-h5": "3.0.0-5020320260806002",
    "pinia": "^2.1.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-cli-shared": "3.0.0-5020320260806002",
    "@dcloudio/uni-stacktracey": "3.0.0-5020320260806002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020320260806002",
    "@vue/runtime-core": "^3.4.21",
    "@vue/tsconfig": "^0.1.3",
    "sass": "^1.77.0",
    "sharp": "^0.35.3",
    "typescript": "^4.9.4",
    "vite": "5.2.8",
    "vue-tsc": "^1.0.24"
  }
}
