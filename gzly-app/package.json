{
  "name": "gzly-app",
  "version": "1.0.0",
  "private": true,
  "description": "GZLY 高考志愿公益辅助系统 App 端（uni-app + Vue3 + TS，一套代码出安卓/苹果/小程序/H5）",
  "scripts": {
    "dev:h5": "uni",
    "dev:app": "uni -p app",
    "dev:mp-weixin": "uni -p mp-weixin",
