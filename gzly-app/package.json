    "build:app": "uni build -p app",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@dcloudio/uni-app": "3.0.0-alpha-1000920260615733",
    "@dcloudio/uni-app-plus": "3.0.0-alpha-1000920260615733",
    "@dcloudio/uni-components": "3.0.0-alpha-1000920260615733",
    "@dcloudio/uni-h5": "3.0.0-alpha-1000920260615733",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-1000920260615733",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "wot-design-uni": "^1.14.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@dcloudio/types": "^3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-alpha-1000920260615733",
    "@dcloudio/uni-stacktracey": "3.0.0-alpha-1000920260615733",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-1000920260615733",
    "@vue/runtime-core": "^3.4.21",
    "sass": "^1.77.0",
    "typescript": "^5.4.0",
    "vite": "^7.3.3",
    "vue-tsc": "^2.0.6"
  }
