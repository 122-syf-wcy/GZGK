# Install as /etc/gzly/gzly.env with mode 600.
# Keep real values only on the server; do not commit production secrets.

GZLY_DB_USERNAME=root
GZLY_DB_PASSWORD=change-me
GZLY_REDIS_PASSWORD=change-me
GZLY_JWT_SECRET=

# ---- 邮箱验证码登录（SMTP） ----
# QQ 邮箱使用授权码而非登录密码；生产环境务必用独立发信账号
GZLY_MAIL_HOST=smtp.qq.com
GZLY_MAIL_PORT=465
GZLY_MAIL_USERNAME=
GZLY_MAIL_PASSWORD=change-me-at-least-32-characters

# Prefer the BCrypt hash. Leave GZLY_ADMIN_PASSWORD unset after migration.
# Generate with: htpasswd -bnBC 12 "" 'your-admin-password' | tr -d ':\n'
GZLY_ADMIN_PASSWORD_HASH=$2y$12$replace-with-bcrypt-hash
GZLY_ADMIN_JWT_EXPIRE_HOURS=8
GZLY_ADMIN_LOGIN_LOCK_LIMIT=5
GZLY_ADMIN_LOGIN_WINDOW_SECONDS=300
GZLY_ADMIN_LOGIN_LOCK_SECONDS=900

GZLY_AI_BASE_URL=https://api.example.com/v1
GZLY_AI_API_KEY=change-me
GZLY_AI_MODEL=gpt-4o-mini

