# === GZLY 高并发内核参数（生产同步副本） ===
# 部署：cp 99-gzly-perf.conf.example /etc/sysctl.d/99-gzly-perf.conf && sysctl --system
#
# 注意：阿里云镜像默认 /etc/sysctl.conf 里有 vm.swappiness=0 与 tcp_max_tw_buckets=5000，
# /etc/sysctl.conf 优先级高于 /etc/sysctl.d/*.conf，需先注掉冲突项：
#   sudo sed -i.bak \
#     -e 's/^vm.swappiness = 0/# vm.swappiness = 0 # see 99-gzly-perf.conf/' \
#     -e 's/^net.ipv4.tcp_max_tw_buckets = 5000/# tcp_max_tw_buckets overridden 200000/' \
#     /etc/sysctl.conf

# ---- 文件描述符 ----
fs.file-max = 2097152
fs.nr_open = 2097152

# ---- 网络栈：连接队列 / SYN backlog ----
net.core.somaxconn = 65535
net.core.netdev_max_backlog = 65535
net.ipv4.tcp_max_syn_backlog = 8192

# ---- TIME_WAIT 复用（仅 reuse；不开 recycle，避免 NAT 后端兼容性问题） ----
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_fin_timeout = 15
net.ipv4.tcp_max_tw_buckets = 200000

# ---- 客户端端口范围扩大 ----
net.ipv4.ip_local_port_range = 1024 65535

# ---- TCP keepalive ----
net.ipv4.tcp_keepalive_time = 300
net.ipv4.tcp_keepalive_intvl = 30
net.ipv4.tcp_keepalive_probes = 5

# ---- TCP buffer / 拥塞控制（BBR 需内核 ≥4.9） ----
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.ipv4.tcp_rmem = 4096 87380 16777216
net.ipv4.tcp_wmem = 4096 65536 16777216
net.ipv4.tcp_congestion_control = bbr
net.core.default_qdisc = fq

# ---- SYN 防护 ----
net.ipv4.tcp_syncookies = 1

# ---- VM ----
vm.swappiness = 10
vm.overcommit_memory = 1
vm.dirty_ratio = 20
vm.dirty_background_ratio = 5
