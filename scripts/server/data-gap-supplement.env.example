# Install this file on the server as:
#   sudo install -m 600 data-gap-supplement.env.example /etc/gzly/data-gap-supplement.env
# Then edit DB_PASS in /etc/gzly/data-gap-supplement.env.

DB_PASS=change-me
RUN_IMPORTER=0
LIMIT=200

