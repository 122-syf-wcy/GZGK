# Copy to infra/.env on the remote server and fill strong credentials.
# NEVER commit infra/.env to Git.

BIND_ADDR=127.0.0.1

# PostgreSQL 16 + pgvector
PG_DB=gzgk
PG_USER=gzgk
PG_PASSWORD=change_me_strong_pg_password
PG_PORT=5432
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE=1536MB
PG_MEM_LIMIT=1536m

# Redis 7
REDIS_PASSWORD=change_me_strong_redis_password
REDIS_PORT=6379
REDIS_MAXMEM=512mb
REDIS_MEM_LIMIT=640m

# Kafka 3.8 KRaft
KAFKA_ADVERTISED_HOST=127.0.0.1
KAFKA_PORT=9092
KAFKA_HEAP=384m
KAFKA_MEM_LIMIT=768m

# Grafana (obs profile)
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_strong_grafana_password

# LLM & Embedding (OpenAI-compatible: DeepSeek / DashScope / OpenAI / Ollama)
LLM_MOCK_MODE=true
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_PRIMARY_MODEL=deepseek-chat
LLM_ROUTER_MODEL=deepseek-chat
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# Langfuse (optional observability)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
