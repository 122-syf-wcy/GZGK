{
  "name": "gzly-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "build:safe": "npm run check:compliance && npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit",
    "check:compliance": "node scripts/check-compliance.mjs && node scripts/check-volunteer-safety-code.mjs",
    "check:compliance:strict": "node scripts/check-compliance.mjs --strict",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vueuse/core": "^10.9.0",
    "axios": "^1.6.8",
    "html2canvas": "^1.4.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^2.1.7",
    "vant": "^4.8.4",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vant/auto-import-resolver": "^1.2.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "~5.4.0",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.6"
  }
}
